{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMO principle version metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "rationale", "scope", "priority", "status", "created", "version", "source", "related_principles", "document"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "priority": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "retired"]},
    "created": {"type": "string", "format": "date"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {"type": "string", "minLength": 1},
    "related_principles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"}},
    "document": {"type": "string", "pattern": "^history/principle_evolution/[A-Z]+-[0-9]{3,}-v[0-9]+\\.[0-9]+\\.[0-9]+\\.md$"}
  }
}
