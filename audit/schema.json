{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMO audit event",
  "type": "object", "additionalProperties": false,
  "required": ["id", "recorded_at", "event_type", "actor", "details", "authorization_basis", "references", "previous_event", "previous_sha256"],
  "properties": {
    "id": {"type": "string", "pattern": "^EVT-[0-9]{4,}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "event_type": {"enum": ["foundation_initialized", "authorization", "approval", "rejection", "access_change", "agent_permissions", "model_migration", "governance_change", "incident"]},
    "actor": {"type": "string", "minLength": 1},
    "details": {"type": "string", "minLength": 1},
    "authorization_basis": {"type": "string", "minLength": 1},
    "references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "previous_event": {"type": ["string", "null"]},
    "previous_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"previous_event": {"type": "null"}}}, "then": {"properties": {"previous_sha256": {"type": "null"}}}, "else": {"properties": {"previous_sha256": {"type": "string"}}}}
  ]
}
